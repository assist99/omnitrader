//@version=6
indicator("EW trading", overlay=true, max_lines_count=500)

// Force compiler historical buffer size allocation
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)
max_bars_back(time, 5000)

// ==========================================
// 🎨 VISUAL TOGGLES & DISPLAY OPTIONS
// ==========================================
var string G_VISUALS = "Display & Visual Toggles"
show_table        = input.bool(true,   title="Show Screener Table",              group=G_VISUALS)
table_mode        = input.string("Normal", title="Screener Table View Mode", options=["Normal", "Compact"], group=G_VISUALS)
show_neely        = input.bool(true,   title="Show Neely Cash Data Baseline",    group=G_VISUALS)
show_local_st     = input.bool(true,   title="Show Local SuperTrend Line",      group=G_VISUALS)
show_legs         = input.bool(false,  title="Show Local ST Leg Section Lines", group=G_VISUALS)
show_synth_legs   = input.bool(false,  title="Show Synth ST Leg Section Lines", group=G_VISUALS)
show_first_leg_hl = input.bool(false,  title="Highlight 1st Local Leg in HTF",   group=G_VISUALS)
show_synth_st     = input.bool(true,   title="Show Synthetic SuperTrend Lines",  group=G_VISUALS)
show_signals      = input.bool(true,   title="Show Signal Arrows",              group=G_VISUALS)


// ==========================================
// 1. Z-SCORE CALCULATIONS, WICK FILTER & BAR COLORING
// ==========================================
var string G_ZSCORE = "Rolling Return Z-Score"
i_length       = input.int(500, title="Rolling Window Length", minval=1, group=G_ZSCORE)
i_minThreshold = input.float(1.8, title="Min Z-Score Threshold", minval=0.0, step=0.1, group=G_ZSCORE)
i_maxThreshold = input.float(10.0, title="Max Z-Score Threshold", minval=0.0, step=0.1, group=G_ZSCORE)

i_colorUp   = input.color(color.new(color.lime, 0), title="Up Bar Color", group=G_ZSCORE)
i_colorDown = input.color(color.new(color.red, 0), title="Down Bar Color", group=G_ZSCORE)

// --- Wick-to-Body Rate Filter Settings ---
var string G_WICK = "Wick Filter Settings"
use_wick_filter = input.bool(true, title="Enable Wick / Body Rate Filter", group=G_WICK)
max_wick_ratio  = input.float(0.3, title="Max Wick / Body Ratio Threshold", minval=0.0, maxval=5.0, step=0.05, group=G_WICK)

// Calculate return statistics
barReturn   = close - open
absReturn   = math.abs(barReturn)
meanReturn  = ta.sma(absReturn, i_length)
stdReturn   = ta.stdev(absReturn, i_length)
returnScore = stdReturn != 0 ? (absReturn - meanReturn) / stdReturn : 0.0

isZScoreHighReturn = returnScore >= i_minThreshold and returnScore < i_maxThreshold

bar_body = math.abs(close - open)
directional_wick = close >= open ? (high - close) : (close - low)
wick_ratio = bar_body > 0 ? (directional_wick / bar_body) : 0.0

passWickFilter = not use_wick_filter or (wick_ratio < max_wick_ratio)
isHighReturnBar = isZScoreHighReturn and passWickFilter

barCol = isHighReturnBar ? (close >= open ? i_colorUp : i_colorDown) : na
barcolor(barCol)
plotcandle(open, high, low, close, title="Colored Candles", color=barCol, wickcolor=barCol, bordercolor=barCol)


// ==========================================
// 2. ENGINE & SUPERTREND INPUTS & SETTINGS
// ==========================================
var string G_SYNTH = "Engine Macro Frame Settings"
bars_per_hour   = input.int(4, title="Bars per Hour (Macro Window 1)", minval=1, group=G_SYNTH)
bars_per_hour_2 = input.int(16, title="Bars per Hour (Macro Window 2)", minval=1, group=G_SYNTH)
show_htf_2      = input.bool(true, title="Enable Macro Window 2 Calculations?", group=G_SYNTH)
macro_atr_len   = input.int(10, title="HTF Equivalent ATR Length", minval=1, group=G_SYNTH)
macro_mult      = input.float(3.0, title="Macro SuperTrend Multiplier", minval=0.01, step=0.01, group=G_SYNTH)
trade_mode      = input.string("First Change Only", "Execution Mode", options=["First Change Only", "Continuous Entries"], group=G_SYNTH)

var string G_LOCAL = "Engine Local Execution Frame Settings"
local_atr_len = input.int(10, title="Local ATR Length", minval=1, group=G_LOCAL)
local_mult    = input.float(3.0, title="Local Multiplier", minval=0.01, step=0.01, group=G_LOCAL)

// Advanced Filtering Options
var string G_FILTERS = "Signal Filters (1st Local Leg Controls)"
max_legs_allowed = input.int(5, title="Filter 1: Max Local ST Legs Allowed in HTF", minval=1, group=G_FILTERS)
use_ext_filter   = input.bool(true, title="Filter 2: Enable Extension Target Filter", group=G_FILTERS)
i_ext_mult       = input.float(1.27, title="Extension Multiplier Level (e.g. 1.27)", step=0.01, minval=0.0, group=G_FILTERS)

// Line Display & Color Customization
var string G_COLORS = "SuperTrend Color Customization"
col_local_up     = input.color(color.new(color.green, 50), title="Local ST Up Color", group=G_COLORS)
col_local_dn     = input.color(color.new(color.red, 50), title="Local ST Down Color", group=G_COLORS)
col_leg_up       = input.color(color.green, title="Local Leg Up Color (Thick)", group=G_COLORS)
col_leg_dn       = input.color(color.red, title="Local Leg Down Color (Thick)", group=G_COLORS)
col_synth_leg_up = input.color(color.blue, title="Synth Leg Up Color (Narrow)", group=G_COLORS)
col_synth_leg_dn = input.color(color.orange, title="Synth Leg Down Color (Narrow)", group=G_COLORS)
col_highlight_up = input.color(color.yellow, title="1st Local Leg Highlight (Up)", group=G_COLORS)
col_highlight_dn = input.color(color.fuchsia, title="1st Local Leg Highlight (Down)", group=G_COLORS)
col_synth_up     = input.color(color.new(color.blue, 50), title="Synth ST 1 Up Color", group=G_COLORS)
col_synth_dn     = input.color(color.new(color.orange, 50), title="Synth ST 1 Down Color", group=G_COLORS)
col_synth2_up    = input.color(color.new(color.teal, 50), title="Synth ST 2 Up Color", group=G_COLORS)
col_synth2_dn    = input.color(color.new(color.purple, 50), title="Synth ST 2 Down Color", group=G_COLORS)


// ==========================================
// 3. SUPERTREND CALCULATIONS
// ==========================================
// --- Synthetic Macro Frame SuperTrend 1 ---
rolling_high  = ta.highest(high, bars_per_hour)
rolling_low   = ta.lowest(low, bars_per_hour)
rolling_close = close
prev_rolling_close = rolling_close[bars_per_hour]

synthetic_tr  = math.max(rolling_high - rolling_low, math.max(math.abs(rolling_high - prev_rolling_close), math.abs(rolling_low - prev_rolling_close)))
synthetic_atr = ta.rma(synthetic_tr, macro_atr_len)
hl2_synthetic = (rolling_high + rolling_low) / 2

var float synth_st_line = na
var int synth_dir = 1 

up_band = hl2_synthetic - (macro_mult * synthetic_atr)
dn_band = hl2_synthetic + (macro_mult * synthetic_atr)

up_band := (rolling_close[1] > synth_st_line[1]) ? math.max(up_band, synth_st_line[1]) : up_band
dn_band := (rolling_close[1] < synth_st_line[1]) ? math.min(dn_band, synth_st_line[1]) : dn_band

if synth_dir == 1 and rolling_close > dn_band
    synth_dir := -1
else if synth_dir == -1 and rolling_close < up_band
    synth_dir := 1

synth_st_line := (synth_dir == -1) ? up_band : dn_band
synth_st_line := barstate.isfirst ? na : synth_st_line

htf_changed = ta.change(synth_dir) != 0
bool is_synth_bullish = synth_dir == -1

// Track HTF Section Start Pivot Bar Index & Extension Target
var int target_htf_start_bar = na
var float first_leg_ext_target = na
var line ext_target_line = na

if htf_changed
    first_leg_ext_target := na

// --- Synthetic SuperTrend Leg Section Tracking Engine ---
var int   synthPrevExtremeBar   = na
var float synthPrevExtremePrice = na

var int   synthCurExtremeBar    = na
var float synthCurExtremePrice  = na

var line  activeSynthLine       = na

if barstate.isfirst
    synthCurExtremeBar   := bar_index
    synthCurExtremePrice := is_synth_bullish ? high : low

if htf_changed
    synthPrevExtremeBar   := synthCurExtremeBar
    synthPrevExtremePrice := synthCurExtremePrice
    target_htf_start_bar  := synthPrevExtremeBar

    synthCurExtremeBar   := bar_index
    synthCurExtremePrice := is_synth_bullish ? high : low

    if show_synth_legs and not na(synthPrevExtremeBar) and not na(synthPrevExtremePrice)
        activeSynthLine := line.new(
             x1 = synthPrevExtremeBar,
             y1 = synthPrevExtremePrice,
             x2 = synthCurExtremeBar,
             y2 = synthCurExtremePrice,
             color = is_synth_bullish ? col_synth_leg_up : col_synth_leg_dn,
             width = 1
             )
else
    if is_synth_bullish
        if na(synthCurExtremePrice) or high >= synthCurExtremePrice
            synthCurExtremePrice := high
            synthCurExtremeBar   := bar_index
    else
        if na(synthCurExtremePrice) or low <= synthCurExtremePrice
            synthCurExtremePrice := low
            synthCurExtremeBar   := bar_index

    if show_synth_legs and not na(activeSynthLine) and not na(synthPrevExtremeBar)
        line.set_x1(activeSynthLine, synthPrevExtremeBar)
        line.set_y1(activeSynthLine, synthCurExtremePrice)
        line.set_x2(activeSynthLine, synthCurExtremeBar)
        line.set_y2(activeSynthLine, synthCurExtremePrice)


// --- Local Frame SuperTrend ---
[m15_st, m15_dir] = ta.supertrend(local_mult, local_atr_len)
m15_st := barstate.isfirst ? na : m15_st

m15_dir_changed = ta.change(m15_dir) != 0
bool is_local_bullish = m15_dir < 0

var bool last_m15_break_is_hr = false
if m15_dir_changed
    last_m15_break_is_hr := isHighReturnBar

// --- Local SuperTrend Leg Section Tracking Engine with Fixed Extreme Detection ---
type LegRef
    line   l
    int    x1
    int    x2
    float  y1
    float  y2
    bool   isBull

var legRefs = array.new<LegRef>()

var int   prevExtremeBar   = na
var float prevExtremePrice = na
var int   curExtremeBar    = na
var float curExtremePrice  = na

var int   legStartBar      = na

var line  activeLine       = na
var int   activeLineX1     = na
var int   activeLineX2     = na
var bool  activeIsBull     = true

if barstate.isfirst
    curExtremeBar   := bar_index
    curExtremePrice := is_local_bullish ? high : low
    legStartBar     := bar_index

if m15_dir_changed
    // Lock in final vertex for the completed leg
    array.push(legRefs, LegRef.new(activeLine, activeLineX1, curExtremeBar, prevExtremePrice, curExtremePrice, activeIsBull))

    prevExtremeBar   := curExtremeBar
    prevExtremePrice := curExtremePrice
    
    // Reset trackers for the NEW directional leg
    legStartBar     := bar_index
    curExtremeBar   := bar_index
    curExtremePrice := is_local_bullish ? high : low

    activeIsBull     := is_local_bullish
    activeLineX1     := prevExtremeBar
    activeLineX2     := curExtremeBar

    if show_legs and not na(prevExtremeBar) and not na(prevExtremePrice)
        color legColor = activeIsBull ? col_leg_up : col_leg_dn
        activeLine := line.new(
             x1 = activeLineX1,
             y1 = prevExtremePrice,
             x2 = activeLineX2,
             y2 = curExtremePrice,
             color = legColor,
             width = 2
             )
    else
        activeLine := na
else
    // Continuously check for new extremes across the entire active leg length
    if is_local_bullish
        if high >= curExtremePrice or na(curExtremePrice)
            curExtremePrice := high
            curExtremeBar   := bar_index
    else
        if low <= curExtremePrice or na(curExtremePrice)
            curExtremePrice := low
            curExtremeBar   := bar_index

    activeLineX2 := curExtremeBar
    if show_legs and not na(activeLine) and not na(prevExtremeBar)
        line.set_x1(activeLine, activeLineX1)
        line.set_y1(activeLine, prevExtremePrice)
        line.set_x2(activeLine, activeLineX2)
        line.set_y2(activeLine, curExtremePrice)

// Dynamic helper function: Calculate EXACT local leg count within active HTF section
get_current_htf_leg_count() =>
    int leg_count = 1  
    int sz = array.size(legRefs)
    if sz > 0 and not na(target_htf_start_bar)
        for i = sz - 1 to 0
            LegRef leg = array.get(legRefs, i)
            if leg.x1 >= target_htf_start_bar
                leg_count += 1
            else
                break
    leg_count

// Retroactively highlight ONLY the 1st Local Leg of the NEW HTF section & Calculate Extension Target
if htf_changed
    if not na(target_htf_start_bar)
        bool highlight_done = false
        int legCount = array.size(legRefs)
        
        if legCount > 0
            for i = 0 to legCount - 1
                LegRef leg = array.get(legRefs, i)
                
                if leg.x1 >= target_htf_start_bar
                    if show_first_leg_hl and not na(leg.l)
                        color hColor = leg.isBull ? col_highlight_up : col_highlight_dn
                        line.set_color(leg.l, hColor)
                        line.set_width(leg.l, 4)
                        
                        label.new(
                             x = int(math.avg(leg.x1, leg.x2)),
                             y = (leg.y1 + leg.y2) / 2,
                             text = "1st Local Leg",
                             color = color.new(hColor, 20),
                             textcolor = color.white,
                             style = label.style_label_center,
                             size = size.tiny
                             )

                    float ext_ratio = i_ext_mult - 1.0
                    float leg_len = math.abs(leg.y2 - leg.y1)
                    if is_synth_bullish  
                        first_leg_ext_target := math.max(leg.y1, leg.y2) + (leg_len * ext_ratio)
                    else                 
                        first_leg_ext_target := math.min(leg.y1, leg.y2) - (leg_len * ext_ratio)

                    if not na(first_leg_ext_target) and show_first_leg_hl
                        ext_target_line := line.new(
                             x1 = target_htf_start_bar,
                             y1 = first_leg_ext_target,
                             x2 = bar_index,
                             y2 = first_leg_ext_target,
                             color = is_synth_bullish ? color.green : color.red,
                             style = line.style_dashed,
                             width = 1
                             )

                    highlight_done := true
                    break 

        if not highlight_done and activeLineX1 >= target_htf_start_bar
            if show_first_leg_hl and not na(activeLine)
                color hColor = activeIsBull ? col_highlight_up : col_highlight_dn
                line.set_color(activeLine, hColor)
                line.set_width(activeLine, 4)
                
                label.new(
                     x = int(math.avg(activeLineX1, activeLineX2)),
                     y = (prevExtremePrice + curExtremePrice) / 2,
                     text = "1st Local Leg",
                     color = color.new(hColor, 20),
                     textcolor = color.white,
                     style = label.style_label_center,
                     size = size.tiny
                     )

if not na(ext_target_line) and show_first_leg_hl
    line.set_x2(ext_target_line, bar_index)


// ==========================================
// 4. SYNTHETIC MACRO FRAME SUPERTREND 2
// ==========================================
rolling_high_2  = ta.highest(high, bars_per_hour_2)
rolling_low_2   = ta.lowest(low, bars_per_hour_2)
prev_rolling_close_2 = rolling_close[bars_per_hour_2]

synthetic_tr_2  = math.max(rolling_high_2 - rolling_low_2, math.max(math.abs(rolling_high_2 - prev_rolling_close_2), math.abs(rolling_low_2 - prev_rolling_close_2)))
synthetic_atr_2 = ta.rma(synthetic_tr_2, macro_atr_len)
hl2_synthetic_2 = (rolling_high_2 + rolling_low_2) / 2

var float synth_st_line_2 = na
var int synth_dir_2 = 1 

up_band_2 = hl2_synthetic_2 - (macro_mult * synthetic_atr_2)
dn_band_2 = hl2_synthetic_2 + (macro_mult * synthetic_atr_2)

up_band_2 := (rolling_close[1] > synth_st_line_2[1]) ? math.max(up_band_2, synth_st_line_2[1]) : up_band_2
dn_band_2 := (rolling_close[1] < synth_st_line_2[1]) ? math.min(dn_band_2, synth_st_line_2[1]) : dn_band_2

if synth_dir_2 == 1 and rolling_close > dn_band_2
    synth_dir_2 := -1
else if synth_dir_2 == -1 and rolling_close < up_band_2
    synth_dir_2 := 1

synth_st_line_2 := (synth_dir_2 == -1) ? up_band_2 : dn_band_2
synth_st_line_2 := barstate.isfirst ? na : synth_st_line_2


// ==========================================
// 5. SMC STRUCTURE CALCULATIONS (CHOCH/BOS)
// ==========================================
len = input.int(50, 'CHoCH Detection Period', group='SMC Structure')
shortLen = input.int(3, 'IDM Detection Period', group='SMC Structure')

bullCss = input.color(#089981, 'Bullish Elements', group = 'Style')
bearCss = input.color(#ff5252, 'Bearish Elements', group = 'Style')

showChoch   = input.bool(true, "Show CHoCH", group = 'Style')
showBos     = input.bool(true, "Show BOS", group = 'Style')
showIdm     = input.bool(true, "Show Inducements", inline = 'idm', group = 'Style')
idmCss      = input.color(color.gray, "", inline = 'idm', group = 'Style')
showSweeps  = input.bool(true, "Show Sweeps", inline = 'sweeps', group = 'Style')
sweepsCss   = input.color(color.gray, "", inline = 'sweeps', group = 'Style')
showCircles = input.bool(true, "Show Swings", group = 'Style')

n = bar_index

swings(int length) =>
    var int os_val = 0
    var int topx_val = na
    var int btmx_val = na
    
    upper = ta.highest(length)
    lower = ta.lowest(length)

    os_val := high[length] > upper ? 0 : low[length] < lower ? 1 : os_val[1]

    top_val = os_val == 0 and os_val[1] != 0 ? high[length] : na
    topx_val := os_val == 0 and os_val[1] != 0 ? n[length] : topx_val

    btm_val = os_val == 1 and os_val[1] != 1 ? low[length] : na
    btmx_val := os_val == 1 and os_val[1] != 1 ? n[length] : btmx_val

    [top_val, topx_val, btm_val, btmx_val]

[top, topx, btm, btmx] = swings(len)
[stop, stopx, sbtm, sbtmx] = swings(shortLen)

var int trend_dir = 0
var bool top_crossed = false
var bool btm_crossed = false

var float max = na
var float min = na
var int max_x1 = na
var int min_x1 = na

var float topy = na
var float btmy = na
var bool stop_crossed = false
var bool sbtm_crossed = false    

if not na(top)
    topy := top
    top_crossed := false
if not na(btm)
    btmy := btm
    btm_crossed := false

bool is_bull_break = close > topy and not top_crossed
bool is_bear_break = close < btmy and not btm_crossed

bool is_choch_bull = is_bull_break and trend_dir != 1
bool is_bos_bull   = is_bull_break and trend_dir == 1

bool is_choch_bear = is_bear_break and trend_dir != -1
bool is_bos_bear   = is_bear_break and trend_dir == -1

if is_bull_break
    top_crossed := true
    trend_dir   := 1
    max         := high
    min         := low
    max_x1      := n
    min_x1      := n
    stop_crossed := false
    sbtm_crossed := false

    if is_choch_bull and showChoch
        line.new(topx, topy, n, topy, color = bullCss, style = line.style_dashed)
        label.new(int(math.avg(n, topx)), topy, 'CHoCH', color = color(na), style = label.style_label_down, textcolor = bullCss, size = size.tiny)
    else if is_bos_bull and showBos
        line.new(topx, topy, n, topy, color = bullCss, style = line.style_solid)
        label.new(int(math.avg(n, topx)), topy, 'BOS', color = color(na), style = label.style_label_down, textcolor = bullCss, size = size.tiny)

if is_bear_break
    btm_crossed := true
    trend_dir   := -1
    max         := high
    min         := low
    max_x1      := n
    min_x1      := n
    stop_crossed := false
    sbtm_crossed := false

    if is_choch_bear and showChoch
        line.new(btmx, btmy, n, btmy, color = bearCss, style = line.style_dashed)
        label.new(int(math.avg(n, btmx)), btmy, 'CHoCH', color = color(na), style = label.style_label_up, textcolor = bearCss, size = size.tiny)
    else if is_bos_bear and showBos
        line.new(btmx, btmy, n, btmy, color = bearCss, style = line.style_solid)
        label.new(int(math.avg(n, btmx)), btmy, 'BOS', color = color(na), style = label.style_label_up, textcolor = bearCss, size = size.tiny)

stopy = fixnan(stop)
sbtmy = fixnan(sbtm)

if low < sbtmy and not sbtm_crossed and trend_dir == 1 and sbtmy != btmy
    if showIdm
        line.new(sbtmx, sbtmy, n, sbtmy, color = idmCss, style = line.style_dotted)
        label.new(int(math.avg(n, sbtmx)), sbtmy, 'IDM', color = color(na), style = label.style_label_up, textcolor = idmCss, size = size.tiny)
    sbtm_crossed := true

if close > max and sbtm_crossed and trend_dir == 1
    if showBos
        line.new(max_x1, max, n, max, color = bullCss)
        label.new(int(math.avg(n, max_x1)), max, 'BOS', color = color(na), style = label.style_label_down, textcolor = bullCss, size = size.tiny)
    sbtm_crossed := false

if high > stopy and not stop_crossed and trend_dir == -1 and stopy != topy
    if showIdm
        line.new(stopx, stopy, n, stopy, color = color.gray, style = line.style_dotted)
        label.new(int(math.avg(n, stopx)), stopy, 'IDM', color = color(na), style = label.style_label_down, textcolor = color.gray, size = size.tiny)
    stop_crossed := true

if close < min and stop_crossed and trend_dir == -1
    if showBos
        line.new(min_x1, min, n, min, color = bearCss)
        label.new(int(math.avg(n, min_x1)), min, 'BOS', color = color(na), style = label.style_label_up, textcolor = bearCss, size = size.tiny)
    stop_crossed := false

if high > max and close < max and trend_dir == 1 and n - max_x1 > 1 and showSweeps
    line.new(max_x1, max, n, max, color = sweepsCss, style = line.style_dotted)
    label.new(int(math.avg(n, max_x1)), max, 'x', color = color(na), style = label.style_label_down, textcolor = sweepsCss)

if low < min and close > min and trend_dir == -1 and n - min_x1 > 1 and showSweeps
    line.new(min_x1, min, n, min, color = sweepsCss, style = line.style_dotted)
    label.new(int(math.avg(n, min_x1)), min, 'x', color = color(na), style = label.style_label_up, textcolor = sweepsCss)

max := math.max(high, max)
min := math.min(low, min)

if max > max[1]
    max_x1 := n
if min < min[1]
    min_x1 := n


// ==========================================
// 6. SIGNAL FILTERS & ENTRY LOGIC
// ==========================================
htf_bullish = synth_dir == -1
htf_bearish = synth_dir == 1

local_bullish = m15_dir == -1
local_bearish = m15_dir == 1

var bool htf_long_taken  = false
var bool htf_short_taken = false

if htf_changed
    htf_long_taken  := false
    htf_short_taken := false

m15_bull_signal   = m15_dir_changed and local_bullish
m15_bear_signal   = m15_dir_changed and local_bearish

synth_bull_signal = htf_changed and htf_bullish
synth_bear_signal = htf_changed and htf_bearish

long_allowed  = (trade_mode == "Continuous Entries") or (trade_mode == "First Change Only" and not htf_long_taken)
short_allowed = (trade_mode == "Continuous Entries") or (trade_mode == "First Change Only" and not htf_short_taken)

// --- Dynamic Filter 1 Logic: Dynamic Leg Count Check ---
current_htf_leg_count = get_current_htf_leg_count()
pass_leg_count_filter = current_htf_leg_count <= max_legs_allowed

// --- Filter 2 Logic: Dynamic Extension Target Filter ---
bool pass_ext_filter = true
if use_ext_filter and not na(first_leg_ext_target)
    if htf_bullish
        pass_ext_filter := open <= first_leg_ext_target  // Avoid buying if already above extension level
    else if htf_bearish
        pass_ext_filter := open >= first_leg_ext_target  // Avoid selling if already below extension level

// Combine Filters
bool signals_allowed = pass_leg_count_filter and pass_ext_filter

raw_primary_long  = m15_bull_signal and htf_bullish and long_allowed and signals_allowed
raw_primary_short = m15_bear_signal and htf_bearish and short_allowed and signals_allowed

entry_long_primary  = raw_primary_long and isHighReturnBar
entry_short_primary = raw_primary_short and isHighReturnBar

synth_break_has_hr_context = isHighReturnBar

entry_long_additional  = synth_bull_signal and synth_break_has_hr_context and signals_allowed
entry_short_additional = synth_bear_signal and synth_break_has_hr_context and signals_allowed

choch_long_signal  = is_choch_bull and local_bullish and htf_bullish and isHighReturnBar and long_allowed and signals_allowed
choch_short_signal = is_choch_bear and local_bearish and htf_bearish and isHighReturnBar and short_allowed and signals_allowed

final_entry_long  = entry_long_primary or entry_long_additional or choch_long_signal
final_entry_short = entry_short_primary or entry_short_additional or choch_short_signal

if final_entry_long
    htf_long_taken := true
if final_entry_short
    htf_short_taken := true

// --- Dynamic Stop Loss Calculation Logic ---
var float sl_price = na

if final_entry_long
    if choch_long_signal
        sl_price := synth_st_line      // Signal by breaking CHoCH: SL set to Synthetic SuperTrend line
    else if entry_long_additional or entry_long_primary
        sl_price := prevExtremePrice   // Set SL to previous M15 ST leg edge (swing vertex)

if final_entry_short
    if choch_short_signal
        sl_price := synth_st_line      // Signal by breaking CHoCH: SL set to Synthetic SuperTrend line
    else if entry_short_additional or entry_short_primary
        sl_price := prevExtremePrice   // Set SL to previous M15 ST leg edge (swing vertex)


// ==========================================
// 7. NEELY CASH DATA ADAPTIVE BASELINE
// ==========================================
var string G_NEELY = "Neely Cash Data Settings"
useAutoTF_neely  = input.bool(true,     title="Auto Detect Period", group=G_NEELY)
manualTF_neely   = input.timeframe("D", title="Manual Timeframe",   group=G_NEELY)
neely_upColor    = input.color(color.lime, title="Fast Up Color",   group=G_NEELY)
neely_downColor  = input.color(color.red,  title="Fast Down Color", group=G_NEELY)
neely_slowColor  = input.color(color.blue, title="Slow Color",      group=G_NEELY)
neely_lineWidth  = input.int(2,            title="Line Width",      group=G_NEELY)
speedMaLen       = input.int(10,          title="Speed Moving Avg Length", minval=1, group=G_NEELY)
speedMult        = input.float(0.2,       title="Speed Threshold Multiplier", minval=0.05, maxval=2.0, step=0.05, group=G_NEELY)

int chartInMinutes = timeframe.isseconds ? 1 : timeframe.isminutes ? timeframe.multiplier : timeframe.isdaily ? 1440 : timeframe.isweekly ? 10080 : timeframe.ismonthly ? 43200 : 1440
string autoTf_neely = chartInMinutes == 1 ? "15" : chartInMinutes <= 5 ? "60" : chartInMinutes < 60 ? "240" : chartInMinutes < 240 ? "1D" : chartInMinutes < 1440 ? "1W" : "1M"
string activeTF_neely = useAutoTF_neely ? autoTf_neely : manualTF_neely

f_calcSpeed(int x1, float y1, int x2, float y2) =>
    int timeDiff = math.abs(x2 - x1)
    float priceDiff = math.abs(y2 - y1)
    float barsDiff = timeDiff / (timeframe.multiplier * 60 * 1000)
    barsDiff > 0 ? (priceDiff / barsDiff) : 0.0

bool isNewTF_neely = timeframe.change(activeTF_neely)

var int   currHighTime = na
var float currHighVal  = na
var int   currLowTime  = na
var float currLowVal   = na
var int   lastPointTime = na
var float lastPointVal  = na
var float[] speedHistory = array.new_float()

if show_neely
    if isNewTF_neely
        int   pHighTime = currHighTime
        float pHighVal  = currHighVal
        int   pLowTime  = currLowTime
        float pLowVal   = currLowVal

        currHighVal  := high
        currHighTime := time
        currLowVal   := low
        currLowTime  := time

        if not na(pHighTime) and not na(pLowTime)
            if na(lastPointTime)
                if pHighTime < pLowTime
                    lastPointTime := pHighTime
                    lastPointVal  := pHighVal
                else
                    lastPointTime := pLowTime
                    lastPointVal  := pLowVal

            int   firstTime  = pHighTime < pLowTime ? pHighTime : pLowTime
            float firstVal   = pHighTime < pLowTime ? pHighVal  : pHighVal
            int   secondTime = pHighTime < pLowTime ? pLowTime  : pHighTime
            float secondVal  = pHighTime < pLowTime ? pLowVal   : pHighVal

            int[]   xCoords = array.new_int()
            float[] yCoords = array.new_float()
            array.push(xCoords, lastPointTime)
            array.push(yCoords, lastPointVal)
            array.push(xCoords, firstTime)
            array.push(yCoords, firstVal)
            array.push(xCoords, secondTime)
            array.push(yCoords, secondVal)

            for s = 0 to 1
                int x1 = array.get(xCoords, s)
                float y1 = array.get(yCoords, s)
                int x2 = array.get(xCoords, s + 1)
                float y2 = array.get(yCoords, s + 1)

                int segDir = y2 >= y1 ? 1 : -1
                float segSpeed = f_calcSpeed(x1, y1, x2, y2)
                float avgSpeed = array.size(speedHistory) > 0 ? array.avg(speedHistory) : 0.0
                float speedThreshold = avgSpeed * speedMult

                color lineColor = neely_slowColor
                if array.size(speedHistory) == 0 or segSpeed >= speedThreshold
                    lineColor := segDir == 1 ? neely_upColor : neely_downColor

                line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, xloc = xloc.bar_time, color = lineColor, width = neely_lineWidth)

                array.push(speedHistory, segSpeed)
                if array.size(speedHistory) > speedMaLen
                    array.shift(speedHistory)

            lastPointTime := secondTime
            lastPointVal  := secondVal
    else
        if high >= currHighVal or na(currHighVal)
            currHighVal  := high
            currHighTime := time
        if low <= currLowVal or na(currLowVal)
            currLowVal  := low
            currLowTime  := time


